package {{.Package}};

import ch.qos.logback.classic.encoder.PatternLayoutEncoder;
import ch.qos.logback.classic.spi.ILoggingEvent;
import ch.qos.logback.core.AppenderBase;

import java.nio.charset.StandardCharsets;

/**
 * logback appender that buffers each test thread's rendered log output so the Sulu
 * glue can attach it per test. Drained once per test by the listener/extension via
 * {@link #drainCurrentThread()}. Registered in src/test/resources/logback-test.xml as
 * &lt;appender name="SuluLog" class="{{.Package}}.SuluLogAppender"&gt; — logback resolves
 * appenders by class name, so there is no log4j2-style packages="…" attribute.
 */
public final class SuluLogAppender extends AppenderBase<ILoggingEvent> {

    private static final String DEFAULT_PATTERN = "%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n";

    // Per-thread buffer: parallel @Test methods each accumulate their own log.
    private static final ThreadLocal<StringBuilder> BUF = ThreadLocal.withInitial(StringBuilder::new);

    private PatternLayoutEncoder encoder;

    /**
     * Setter for the nested &lt;encoder&gt; element. The parameter type is deliberately the
     * concrete PatternLayoutEncoder, not the Encoder interface: logback only maps a
     * class-less &lt;encoder&gt; to PatternLayoutEncoder for its own appenders, so an
     * interface-typed setter would force every user to write class="…" in the XML.
     */
    public void setEncoder(final PatternLayoutEncoder encoder) {
        this.encoder = encoder;
    }

    @Override
    public void start() {
        if (encoder == null) {
            encoder = new PatternLayoutEncoder();
        }
        if (encoder.getPattern() == null) {
            encoder.setPattern(DEFAULT_PATTERN);
        }
        encoder.setContext(getContext());
        if (!encoder.isStarted()) {
            encoder.start();
        }
        super.start();
    }

    @Override
    protected void append(final ILoggingEvent event) {
        BUF.get().append(new String(encoder.encode(event), StandardCharsets.UTF_8));
    }

    /** Returns and clears this thread's buffered log. */
    public static String drainCurrentThread() {
        final StringBuilder sb = BUF.get();
        final String out = sb.toString();
        sb.setLength(0);
        return out;
    }
}
